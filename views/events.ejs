<%- include('partials/header') %>
<section class="page-head">
  <div class="wrap">
    <h1><%= t('events') %></h1>
    <p class="lede"><%= lang === 'ml' ? 'പരിശീലനങ്ങൾ, ബോധവൽക്കരണ ക്ലാസുകൾ, മോക്ക് ഡ്രില്ലുകൾ, ക്യാമ്പുകൾ, ആദരവുകൾ.' : 'Trainings, awareness classes, mock drills, camps and felicitations.' %></p>
  </div>
</section>
<section class="section">
  <div class="wrap">
    <h2><%= t('upcoming_events') %></h2>
    <% if (!upcoming.length) { %><p class="empty"><%= t('no_items') %></p><% } %>
    <div class="grid-cards">
      <% upcoming.forEach(e => { %><%- include('partials/event-card', { e }) %><% }) %>
    </div>
  </div>
</section>
<% if (past.length) { %>
<section class="section section-alt">
  <div class="wrap">
    <h2><%= t('past_events') %></h2>
    <div class="grid-cards">
      <% past.forEach(e => { %><%- include('partials/event-card', { e }) %><% }) %>
    </div>
  </div>
</section>
<% } %>
<%- include('partials/footer') %>
