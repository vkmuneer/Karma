<%- include('partials/header') %>
<section class="page-head"><div class="wrap"><h1><%= t('gallery') %></h1></div></section>
<section class="section">
  <div class="wrap">
    <% if (!photos.length) { %><p class="empty"><%= t('no_items') %></p><% } %>
    <%- include('partials/photo-grid', { photos, full: true, captionOf: (p) => [p.caption, p.mission_title || p.event_title].filter(Boolean).join(' · ') }) %>
  </div>
</section>
<%- include('partials/footer') %>
