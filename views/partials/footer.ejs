</main>
<footer class="footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <img src="/img/logo-160.png" alt="<%= s.org_name_en %> logo" width="96" height="96" loading="lazy">
      <div>
        <strong><%= s.org_name_ml %></strong>
        <p><%= s.org_name_en %><br><%= t('registered_trust') %></p>
      </div>
    </div>
    <div>
      <h3><%= t('contact') %></h3>
      <p class="muted"><%= s.address %></p>
      <p><% (s.phones || []).forEach(p => { %><a class="phone-link" href="<%= h.telLink(p) %>"><%= p %></a> <% }) %></p>
      <% if (s.contact_email) { %><p><a href="mailto:<%= s.contact_email %>"><%= s.contact_email %></a></p><% } %>
    </div>
    <div>
      <h3><%= t('follow_us') %></h3>
      <p class="socials">
        <% if (s.facebook) { %><a href="<%= s.facebook %>" target="_blank" rel="noopener">Facebook</a><% } %>
        <% if (s.instagram) { %><a href="<%= s.instagram %>" target="_blank" rel="noopener">Instagram</a><% } %>
        <% if (s.youtube) { %><a href="<%= s.youtube %>" target="_blank" rel="noopener">YouTube</a><% } %>
        <% if (s.whatsapp) { %><a href="https://wa.me/<%= s.whatsapp %>" target="_blank" rel="noopener">WhatsApp</a><% } %>
      </p>
      <p><a href="/join"><%= t('join') %> →</a></p>
      <p><a href="/member"><%= member ? t('member_area') : t('member_login') %> →</a></p>
    </div>
  </div>
  <div class="wrap footer-base">© <%= new Date().getFullYear() %> <%= s.org_name_en %></div>
</footer>
<nav class="tabbar" aria-label="Quick">
  <a href="/" class="<%= path === '/' ? 'on' : '' %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11 12 3l9 8v10h-6v-6H9v6H3z"/></svg><span><%= t('home') %></span></a>
  <a href="/missions" class="<%= path.startsWith('/missions') ? 'on' : '' %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 20 9 7l4 6 3-4 6 11z"/></svg><span><%= t('missions') %></span></a>
  <a href="/alerts" class="<%= path.startsWith('/alerts') ? 'on' : '' %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22a2.5 2.5 0 0 0 2.5-2.5h-5A2.5 2.5 0 0 0 12 22zm7-6V11a7 7 0 0 0-5.5-6.8V3a1.5 1.5 0 0 0-3 0v1.2A7 7 0 0 0 5 11v5l-2 2v1h18v-1z"/></svg><span><%= t('alerts') %></span><% if (liveAlerts.length) { %><i class="dot"></i><% } %></a>
  <a href="/team" class="<%= path.startsWith('/team') ? 'on' : '' %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm8 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM1 21v-2c0-3 4-5 8-5s8 2 8 5v2zm17 0v-2c0-1.4-.6-2.6-1.6-3.5 3 .3 6.6 1.6 6.6 3.5v2z"/></svg><span><%= t('team') %></span></a>
  <a href="/member" class="<%= path.startsWith('/member') ? 'on' : '' %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10zm0 2c-4 0-9 2-9 5v3h18v-3c0-3-5-5-9-5z"/></svg><span><%= t('members_tab') %></span></a>
</nav>
<div class="lightbox" id="lightbox" hidden>
  <button type="button" class="lightbox-close" aria-label="Close">×</button>
  <img alt="">
  <p class="lightbox-caption"></p>
</div>
<script src="/js/common.js?v=1" defer></script>
<script src="/js/site.js?v=1" defer></script>
</body>
</html>
