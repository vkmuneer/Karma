<%- include('partials/header') %>
<section class="page-head">
  <div class="wrap">
    <h1><%= t('team') %></h1>
    <p class="lede"><%= lang === 'ml' ? 'വിവിധ തുറകളിൽ ജോലി ചെയ്യുന്ന, വിദഗ്ധ പരിശീലനം ലഭിച്ച ചെറുപ്പക്കാർ.' : 'Trained young volunteers from many walks of life.' %></p>
  </div>
</section>

<section class="section team-filter-bar">
  <div class="wrap">
    <div class="toolbar">
      <label class="sr-only" for="team-search"><%= t('search') %></label>
      <input id="team-search" type="search" placeholder="<%= lang === 'ml' ? 'പേര്, സ്ഥലം, കഴിവ് എന്നിവ തിരയുക…' : 'Search name, place or skill…' %>" autocomplete="off">
      <% if (allSkills.length) { %>
      <label class="sr-only" for="team-skill"><%= t('skills') %></label>
      <select id="team-skill">
        <option value=""><%= t('filter_skill') %> (<%= total %>)</option>
        <% allSkills.forEach(sk => { %><option value="<%= sk.key %>"><%= sk.name %> (<%= sk.count %>)</option><% }) %>
      </select>
      <% } %>
      <button type="button" class="btn btn-outline btn-clear" id="team-clear" hidden><%= lang === 'ml' ? 'ഫിൽട്ടർ മാറ്റുക' : 'Clear' %></button>
    </div>
    <p class="filter-result" id="team-result" role="status" hidden data-one="<%= lang === 'ml' ? '1 പേരെ കണ്ടെത്തി' : '1 person found' %>" data-many="<%= lang === 'ml' ? '{n} പേരെ കണ്ടെത്തി' : '{n} people found' %>"></p>
    <p class="empty" id="team-empty" hidden><%= lang === 'ml' ? 'ഈ തിരച്ചിലിന് ആരെയും കണ്ടെത്തിയില്ല.' : 'Nobody matches this search.' %></p>
  </div>
</section>

<% if (office.length) { %>
<section class="section team-group">
  <div class="wrap">
    <h2><%= t('office_bearers') %></h2>
    <% const top = office.filter(p => ['chairman', 'convenor', 'treasurer'].includes(p.role)); const rest = office.filter(p => !top.includes(p)); %>
    <% if (top.length) { %>
    <div class="people people--big people--top">
      <% top.forEach(p => { %><%- include('partials/person-card', { p, big: true }) %><% }) %>
    </div>
    <% } %>
    <% if (rest.length) { %>
    <div class="people people--big <%= top.length ? 'people--after' : '' %>">
      <% rest.forEach(p => { %><%- include('partials/person-card', { p, big: true }) %><% }) %>
    </div>
    <% } %>
  </div>
</section>
<% } %>

<% if (executive.length) { %>
<section class="section section-alt team-group">
  <div class="wrap">
    <h2><%= t('executive_committee') %></h2>
    <div class="people">
      <% executive.forEach(p => { %><%- include('partials/person-card', { p }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (volunteers.length) { %>
<section class="section team-group">
  <div class="wrap">
    <div class="section-head">
      <h2><%= t('all_volunteers') %> <span class="count" data-group-count><%= volunteers.length %></span></h2>
    </div>
    <div class="people people--compact" id="volunteer-list">
      <% volunteers.forEach(p => { %><%- include('partials/person-card', { p }) %><% }) %>
    </div>
  </div>
</section>
<% } %>
<%- include('partials/footer') %>
